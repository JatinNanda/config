#!/usr/bin/env python3
"""Record which tmux window and Claude session created a PR.

Runs as a PostToolUse hook on Bash. When a `gh pr create` succeeds, the PR URL
appears in the tool response; pair it with $TMUX_PANE's window so prw can send
you back to the window that spawned the work rather than to whichever worktree
happens to hold the branch.
"""
import json
import os
import re
import subprocess
import sys
import time

INDEX = os.path.expanduser("~/.cache/prw/origins.jsonl")
PR_URL = re.compile(r"https://github\.com/([^/\s]+)/([^/\s]+)/pull/(\d+)")


def tmux(fmt, target=None):
    cmd = ["tmux", "display-message", "-p"]
    if target:
        cmd += ["-t", target]
    cmd.append(fmt)
    try:
        out = subprocess.run(cmd, capture_output=True, text=True, check=True).stdout
    except (subprocess.CalledProcessError, FileNotFoundError):
        return ""
    return out.strip()


def main():
    try:
        ev = json.load(sys.stdin)
    except (json.JSONDecodeError, ValueError):
        return 0

    ti = ev.get("tool_input") or {}
    cmd = ti.get("command") or ""
    if "pr create" not in cmd:
        return 0

    blob = json.dumps(ev.get("tool_response") or ev)
    urls = PR_URL.findall(blob)
    if not urls:
        return 0

    pane = os.environ.get("TMUX_PANE") or ""
    rec = {
        "ts": int(time.time()),
        "session_id": ev.get("session_id") or "",
        "cwd": ev.get("cwd") or os.getcwd(),
        "window_id": tmux("#{window_id}", pane) if pane else "",
        "window_name": tmux("#{window_name}", pane) if pane else "",
        "tmux_session": tmux("#{session_name}", pane) if pane else "",
    }

    os.makedirs(os.path.dirname(INDEX), exist_ok=True)
    seen = set()
    with open(INDEX, "a", encoding="utf-8") as f:
        for owner, repo, num in urls:
            key = f"{owner}/{repo}#{num}"
            if key in seen:
                continue
            seen.add(key)
            f.write(json.dumps(dict(rec, pr=key)) + "\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
