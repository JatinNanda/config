lua << EOF
require('lspconfig').yamlls.setup({
  filetypes = { "yaml", "yaml.docker-compose" },  -- exclude "helm" filetype
  on_attach = function(client, bufnr)
    -- Detach yamlls if the file is in a helm templates directory
    local path = vim.api.nvim_buf_get_name(bufnr)
    if path:match("/templates/") then
      vim.defer_fn(function()
        vim.lsp.buf_detach_client(bufnr, client.id)
      end, 100)
    end
  end,
  settings = {
    yaml = {
      validate = true,
      completion = true,
      hover = true,
      schemaStore = {
        enable = true,
      },
      schemas = {
        kubernetes = "*.yaml",
      },
      schemaDownload = { enable = true },
      enableSchemaRequest = true,  -- enables #:schema support
    }
  }
})
EOF

