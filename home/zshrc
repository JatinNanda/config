# runs pytests from name regardless of path
ptf() {
    find . -name "$1" -not -path "./node_modules/*" | xargs pytest
}

# runs python from name regardless of path
pyf() {
    find . -name "$1" -not -path "./node_modules/*" | xargs python
}

# find files from name
f() {
    find . -name "$1" -not -path "./node_modules/*"
}

# unix timestamp conversion
dt() {
    if [ -z $1 ]; then
        date '+%s'
    else
        date -d "@$1"
    fi
}

# cd to a directory 2 levels deep from root
cdf() {
    result=$(print -l $HOME/code/* | fzf)
    if [ ! -z "$result" ]; then
        cd $result
    fi
}

# ---- git worktree navigation -----------------------------------------------
# Rendering lives in ~/.local/bin/wt-render (standalone so fzf's reload binding
# can call it); ~/.local/bin/wt-kill removes a worktree. ▶ here, ● dirty, ⚠ branch≠dir.

# wtl — at-a-glance overview of every worktree
wtl() {
    emulate -L zsh
    WT_CUR=$(git rev-parse --show-toplevel 2>/dev/null) wt-render | cut -f2-
}

# cdw — interactive navigator.
#   space : mark/unmark (multi-select)
#   enter : switch (jump to the worktree's tmux window if one exists, else cd)
#   ctrl-x: kill marked worktrees — or the hovered one if none marked ({+1}) —
#           confirms once, then refreshes the list in place
cdw() {
    emulate -L zsh
    local cur sel wtpath win
    cur=$(git rev-parse --show-toplevel 2>/dev/null)
    sel=$(WT_CUR=$cur wt-render \
        | fzf --ansi --multi --delimiter='\t' --with-nth=2.. \
              --preview='git -C {1} -c color.status=always status -sb; echo; git -C {1} log --color=always --oneline -10' \
              --preview-window='right,58%,border-left' \
              --bind='ctrl-n:down,ctrl-p:up' \
              --bind='space:toggle+down' \
              --bind="ctrl-x:execute(wt-kill {+1} >/dev/tty 2>&1)+reload(WT_CUR=$cur wt-render)" \
              --header='space: mark   enter: switch   ctrl-x: kill marked')
    [[ -z $sel ]] && return
    wtpath=${sel##*$'\n'}
    wtpath=${wtpath%%$'\t'*}
    [[ -d $wtpath ]] || return
    if [[ -n $TMUX ]]; then
        win=$(tmux list-windows -F '#{window_id} #{pane_current_path}' 2>/dev/null \
              | awk -v p="$wtpath" '$2==p || index($2, p"/")==1 {print $1; exit}')
        [[ -n $win ]] && { tmux select-window -t "$win"; return; }
    fi
    cd "$wtpath"
}

# search and replace across matching files
sr() {
    ag -l "$1" | xargs sed -i '' "s/$1/$2/g"
}

# fzf-clone a repo from an org (defaults to $GH_ORG, else your own repos)
clone() {
    local org="${1:-$GH_ORG}"
    local result
    if [ -n "$org" ]; then
        result=$(gh repo list "$org" -L 50000 | awk '{print $1}' | fzf)
    else
        result=$(gh repo list -L 50000 | awk '{print $1}' | fzf)
    fi
    [ -n "$result" ] && git clone "https://github.com/$result"
}

# checkout branch (fzf if no arg)
co() {
    if [ ! -z "$1" ]; then
        git checkout "$1"
    else
        branch=$(git branch | fzf | rev | cut -d ' ' -f -1 | rev)
        [ -n "$branch" ] && git checkout $branch
    fi
}

# pull feature branch onto this one
gpullfeat() {
    if [ ! -z "$1" ]; then
        git pull . "$1"
    else
        branch=$(git branch | fzf | rev | cut -d ' ' -f -1 | rev)
        [ -n "$branch" ] && git pull . $branch
    fi
}

# rebase current branch on the remote default branch
gbasemaster() {
    branch=$(git branch --show-current)
    master_branch=$(git remote show origin | sed -n 's/.*HEAD branch: //p')
    if [ "$branch" != "$master_branch" ]; then
        git fetch
        git rebase -i origin/$master_branch
    fi
}

# hard reset to the remote default branch
gresetmaster() {
    git fetch
    master_branch=$(git remote show origin | sed -n 's/.*HEAD branch: //p')
    git reset --hard origin/$master_branch
}

# new branch off the freshest local base (dev/master/main)
gnewb() {
    branch=$(git branch | ag '^dev$|^master$|^main$' | awk '{$1=$1};1' | sed 's/* //')
    git co $branch
    git pull
    git co -b "$1"
}

# cd to git project root
cdr() {
    cd "$(git rev-parse --show-toplevel)"
}

# open files from the last n commits' diff (defaults to last)
vd() {
    file=$(git diff HEAD~${1:-1} --name-only | fzf)
    if [ ! -z "$file" ]; then
        vim "$(git rev-parse --show-toplevel)/$file"
    fi
}

# git diff last n commits (defaults to last commit)
gdiffhead() {
    git diff HEAD~${1:-1}
}

togb() {
  awk '{ printf "%.2f GB\n", $1 / (1024 * 1024 * 1024) }'
}

