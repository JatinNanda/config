# git worktree helper — opens a new tmux window in an isolated worktree
# usage: wt <feature-name> | wt close [feature-name]
wt() {
  # wt close — remove worktree + delete local branch
  if [[ "$1" == "close" ]]; then
    local feature="$2"
    local repo_root
    repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || { echo "not in a git repo"; return 1; }

    local worktree_path branch
    if [[ -n "$feature" ]]; then
      local repo_name=$(basename "$repo_root")
      worktree_path="$HOME/.worktrees/$repo_name/$feature"
      branch="jatin/$feature"
    else
      worktree_path="$PWD"
      branch=$(git -C "$worktree_path" rev-parse --abbrev-ref HEAD 2>/dev/null)
      feature=$(basename "$worktree_path")
    fi

    if [[ "$PWD" == "$worktree_path"* ]]; then
      cd "$repo_root" || return 1
    fi

    git -C "$repo_root" worktree remove --force "$worktree_path" 2>/dev/null
    git -C "$repo_root" worktree prune 2>/dev/null
    git -C "$repo_root" branch -D "$branch" 2>/dev/null && echo "deleted branch $branch"
    echo "closed worktree: $feature"

    if [[ -n "$TMUX" ]]; then
      local win_name
      win_name=$(tmux display-message -p '#W')
      if [[ "$win_name" == "$feature" ]]; then
        tmux kill-window
      fi
    fi
    return 0
  fi

  local repo_root
  # pick base repo from ~/code via fzf — independent of cwd
  repo_root=$(find "$HOME/code" -mindepth 1 -maxdepth 2 -name .git -type d 2>/dev/null \
    | sed 's|/.git$||' \
    | sort \
    | fzf --prompt="repo: " --header="select base repo for worktree" \
          --bind='ctrl-n:down,ctrl-p:up')
  [[ -z "$repo_root" ]] && { echo "no repo selected"; return 1; }

  local repo_name=$(basename "$repo_root")

  # base off the remote's actual default branch (main/master/etc.)
  local default_branch
  default_branch=$(git -C "$repo_root" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null)
  default_branch=${default_branch#origin/}
  if [[ -z "$default_branch" ]]; then
    git -C "$repo_root" remote set-head origin --auto >/dev/null 2>&1
    default_branch=$(git -C "$repo_root" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null)
    default_branch=${default_branch#origin/}
  fi
  [[ -z "$default_branch" ]] && default_branch=master
  local base_ref="origin/$default_branch"

  local feature branch worktree_path
  if [[ -z "$1" ]]; then
    echo "usage: wt <feature>  (use cdw to switch between existing worktrees)"
    return 1
  fi

  feature="$1"
  branch="jatin/$feature"
  worktree_path="$HOME/.worktrees/$repo_name/$feature"

  # if branch is already checked out somewhere, just open a window there
  local existing_path
  existing_path=$(git -C "$repo_root" worktree list --porcelain 2>/dev/null \
    | awk -v b="refs/heads/$branch" '/^worktree /{path=$2} /^branch /{if ($2==b){print path; exit}}')

  if [[ -n "$existing_path" ]]; then
    echo "branch already checked out at $existing_path, opening there"
    tmux new-window -n "$feature" -c "$existing_path" "${SHELL:-zsh}"
    return 0
  fi

  # create the worktree on a fresh branch off latest base
  mkdir -p "$(dirname "$worktree_path")"
  echo "basing off $base_ref..."
  git -C "$repo_root" fetch origin --quiet
  git -C "$repo_root" worktree add -b "$branch" "$worktree_path" "$base_ref" || return 1

  # new tmux window: claude on the left, shell on the right
  tmux new-window -n "$feature" -c "$worktree_path" \
    "~/.claude/hooks/wt-claude.sh '$feature'"
  tmux split-window -h -t "$feature" \
    "~/.claude/hooks/wt-session.sh '$worktree_path' '$repo_root'"
}

# fzf dockerhub tags for a given image: latest <namespace/repo>
latest() {
  local image="$1"
  [[ -z "$image" ]] && { echo "usage: latest <namespace/repo>"; return 1; }
  local tag
  tag=$(curl -s "https://hub.docker.com/v2/repositories/${image}/tags/?page_size=50&ordering=last_updated" \
    | jq -r '.results[].name' \
    | tac \
    | fzf --tac --prompt="$image:" --header="select a tag")
  [[ -z "$tag" ]] && return 1
  echo -n "${image}:${tag}" | pbcopy
  echo "copied: ${image}:${tag}"
}

